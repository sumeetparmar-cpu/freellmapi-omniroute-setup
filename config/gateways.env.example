# Non-secret defaults shared by the Termux and PowerShell scripts.
# Copy to $GW_HOME/config/gateways.env (Termux) or %USERPROFILE%\llm-gateways\config\gateways.env
# (Windows) ONLY if you want to override a default. Contains no secrets.
#
# Where everything lives (outside this Git repo):
#   GW_HOME=$HOME/llm-gateways
#
# Each gateway gets its own port, install dir, data dir, env file and PID file.
# The two ports MUST differ; the scripts refuse to start if they are equal.
FREELLMAPI_PORT=3001
OMNIROUTE_PORT=20128

# Bind address. 127.0.0.1 = this device only (recommended).
# Use 0.0.0.0 only on a trusted network, and only with API-key auth enabled.
GATEWAY_BIND_HOST=127.0.0.1

# Pinned upstream refs ("main"/"latest" follow upstream; pin a tag/version for repeatability).
FREELLMAPI_REF=main
OMNIROUTE_VERSION=latest
